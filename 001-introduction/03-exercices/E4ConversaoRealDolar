package aprendendo_java_2026;

import java.util.Scanner;

public class E4ConversaoRealDolar {

	public static void main(String[] args) {
		/*
		 * Solicite ao usuário que digite um valor em reais.
		 * Armazene o valor em uma variável.
		 * Solicite ao usuário que digite a cotação do dólar.
		 * Armazene a cotação em uma variável.
		 * Converta o valor em reais para dólares utilizando a fórmula: valor em dólares = valor em reais / cotação.
		 * Exiba o valor em dólares.
		 */
		
		// variáveis
		double valor_real, valor_dolar, cotacao_dolar;
		
		// criando o scanner
		Scanner sc = new Scanner(System.in);
		
		// guardando o valor em real
		System.out.print("Digite seu valor em reais: R$");
		valor_real = sc.nextDouble();
		
		// guardando o valor da cotação do dólar
		System.out.print("Digite o valor da cotação do dólar atual: US$1 = R$");
		cotacao_dolar = sc.nextDouble();
		
		// lógica
		valor_dolar = valor_real/cotacao_dolar;
		System.out.printf("Na conversão para dólar, você tem: US$%f", valor_dolar);
	
	}
}
